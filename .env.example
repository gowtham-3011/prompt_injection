# Copy to .env (git-ignored) and fill in only what you use.

# Which LLM backend to use: anthropic | ollama | mock  (overrides configs/default.yaml)
PIF_LLM_BACKEND=ollama
# Optional model override for the selected backend
# PIF_LLM_MODEL=llama3.2:3b

# Anthropic backend
# ANTHROPIC_API_KEY=sk-ant-...

# Ollama backend (local model, free)
# OLLAMA_HOST=http://localhost:11434
